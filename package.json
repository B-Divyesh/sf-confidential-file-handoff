{
  "name": "confidential-file-handoff",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run && node --test api/license-verify/index.test.cjs",
    "test:browser": "playwright test",
    "test": "vitest run && node --test api/license-verify/index.test.cjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "axe-core": "^4.10.3",
    "eslint": "^9.35.0",
    "playwright": "1.58.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  }
}
