{
  "name": "confidential-file-handoff",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run && node --test api/license-verify/index.test.cjs",
    "test:browser": "playwright test",
    "test": "vitest run && node --test api/license-verify/index.test.cjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.22"
  },
  "overrides": {
    "@azure/abort-controller": "2.1.2",
    "@azure/core-auth": "1.9.0",
    "@azure/core-client": "1.9.4",
    "@azure/core-paging": "1.6.2",
    "@azure/core-rest-pipeline": "1.20.0",
    "@azure/core-tracing": "1.2.0",
    "@azure/core-util": "1.12.0",
    "@azure/core-xml": "1.4.5",
    "@azure/logger": "1.2.0",
    "@typespec/ts-http-runtime": "0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "axe-core": "^4.10.3",
    "eslint": "^9.35.0",
    "playwright": "1.58.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  }
}
